@page "/"
@using Syncfusion.Blazor.Diagram

<SfDiagramComponent @ref="diagram"
                    Height="800px"
                    Width="2000px"
                    Nodes="@nodes"
                    Connectors="@connectors"
                    NodeCreating="OnNodeCreating">
    <Layout Type="LayoutType.OrganizationalChart"
            HorizontalSpacing="20"
            VerticalSpacing="30"
            Orientation="LayoutOrientation.TopToBottom">
    </Layout>
    <SnapSettings Constraints="SnapConstraints.None"></SnapSettings>
    <DataSourceSettings ID="Id" ParentID="ParentId" DataSource="@orgNodes">
    </DataSourceSettings>
</SfDiagramComponent>

@code {
    private SfDiagramComponent? diagram;

    // ── Diagram node/connector collections (populated automatically by DataSourceSettings) ──
    private DiagramObjectCollection<Node> nodes = new();
    private DiagramObjectCollection<Connector> connectors = new();

    // ── Flat list consumed by DataSourceSettings ──────────────────────────────
    private List<OrgNode> orgNodes = new();

    // ── Hierarchical source data (mimics the customer's Grupo/Division/Taller/Seccion structure) ──
    private List<Grupo> estructura = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Mirrors customer's: await sessionStorage.GetItemAsync<List<Grupo>>("Organigrama")
            estructura = await Task.FromResult(BuildEstructura());

            // Flatten it into the list that DataSourceSettings expects
            orgNodes = AplanarEstructura(estructura);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    // ── Node styling ──────────────────────────────────────────────────────────
    private void OnNodeCreating(IDiagramObject obj)
    {
        if (obj is not Node node) return;

        node.Width = 180;
        node.Height = 50;

        // Read data bound from DataSourceSettings
        var orgNode = node.Data as OrgNode;

        // Color nodes differently by level / type
        string fill = orgNode?.Tipo switch
        {
            "Grupo" => "#1e3a5f",
            "Division" => "#2d6a9f",
            "Taller" => "#4a90c4",
            _ => "#7fb3d3"   // Seccion
        };

        node.Style = new ShapeStyle
        {
            Fill = fill,
            StrokeColor = "#0d2b45",
            StrokeWidth = 1
        };

        // Set annotation text to the node's Nombre (same as what appears in the image)
        node.Annotations = new DiagramObjectCollection<ShapeAnnotation>
        {
            new ShapeAnnotation
            {
                Content = orgNode?.Nombre ?? string.Empty,
                Style   = new TextStyle
                {
                    Color    = "#ffffff",
                    FontSize = 11,
                    Bold     = true
                },
                HorizontalAlignment = HorizontalAlignment.Center,
                VerticalAlignment   = VerticalAlignment.Center
            }
        };
    }

    // ── Flatten hierarchy → flat list (same logic as customer, but CORRECT placement) ──
    private static List<OrgNode> AplanarEstructura(List<Grupo> grupos)
    {
        var lista = new List<OrgNode>();
        int contador = 0;

        foreach (var grupo in grupos)
        {
            var grupoId = $"n{contador++}";
            lista.Add(new OrgNode { Id = grupoId, ParentId = null, Nombre = grupo.Nombre, Tipo = "Grupo" });

            foreach (var division in grupo.Divisiones)
            {
                var divisionId = $"n{contador++}";
                lista.Add(new OrgNode { Id = divisionId, ParentId = grupoId, Nombre = division.Nombre, Tipo = "Division" });
                foreach (var taller in division.Talleres)
                {
                    var tallerId = $"n{contador++}";
                    lista.Add(new OrgNode { Id = tallerId, ParentId = divisionId, Nombre = taller.Nombre, Tipo = "Taller" });

                    foreach (var seccion in taller.Secciones)
                    {
                        var seccionId = $"n{contador++}";
                        lista.Add(new OrgNode { Id = seccionId, ParentId = tallerId, Nombre = seccion, Tipo = "Seccion" });
                    }
                }
            }
        }

        return lista;
    }

    // ── Sample hierarchical data – 500 nodes per Grupo (1000 total) ──────────
    // Layout: 1 root + 5 divisions + 50 talleres (10/div) + 444 secciones = 500
    private static List<Grupo> BuildEstructura()
