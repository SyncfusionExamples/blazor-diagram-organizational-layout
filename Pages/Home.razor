                    "NEG. INFORMES FINANCIEROS","NEG. FISCALIDAD","NEG. INVERSIONES","NEG. CONTROL GESTIÓN","NEG. TESORERÍA" }
        };
        var tallerPrefixes2 = new[] {
            // Div-1
            new[] { "TALLER MOTORES","TALLER AVIÓNICOS","TALLER ESTRUCTURAS","TALLER HIDRÁULICOS","TALLER ELÉCTRICOS",
                    "TALLER COMBUSTIBLE","TALLER SISTEMAS VUELO","TALLER PRESURIZACIÓN","TALLER PINTURA","TALLER COMPOSITES" },
            // Div-2
            new[] { "TALLER VEH. LIGEROS","TALLER VEH. PESADOS","TALLER ARMAMENTO","TALLER ELECTRÓNICA","TALLER GENERADORES",
                    "TALLER EQUIPOS GSE","TALLER INFRAESTRUCTURAS","TALLER ELEVACIÓN","TALLER EQUIPOS ESPECIALES","TALLER COMBUSTIBLE TIERRA" },
            // Div-3
            new[] { "NEG. PLAN. MANTENIMIENTO","NEG. DOCUMENTACIÓN TÉCNICA","NEG. FIABILIDAD","NEG. AERONAVEGABILIDAD","NEG. MODIFICACIONES",
